{
  "name": "freelance-tax-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "個人事業主・フリーランス向けの2026年税金予測シミュレーター",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots:normalize": "node scripts/normalize-screenshots.mjs",
    "preview": "firebase emulators:start --only hosting --project demo-freelance-tax-local",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "hosting:deploy": "firebase deploy --only hosting"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "firebase-tools": "^15.25.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
